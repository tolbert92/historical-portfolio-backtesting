{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Historical Backtest Input v1.0",
  "required": [
    "schema_version",
    "execution",
    "portfolio",
    "market_data",
    "simulation",
    "assumptions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "execution": {
      "type": "object",
      "required": [
        "mode",
        "run_id",
        "validation_policy"
      ],
      "properties": {
        "mode": {
          "enum": [
            "standalone",
            "agent"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "validation_policy": {
          "const": "tiered"
        }
      },
      "additionalProperties": false
    },
    "portfolio": {
      "type": "object",
      "required": [
        "portfolio_id",
        "currency",
        "initial_capital",
        "positions"
      ],
      "properties": {
        "portfolio_id": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "initial_capital": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "positions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "asset_id",
              "target_weight"
            ],
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1
              },
              "target_weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "market_data": {
      "type": "object",
      "required": [
        "frequency",
        "price_type",
        "return_convention",
        "series",
        "provenance"
      ],
      "properties": {
        "frequency": {
          "enum": [
            "daily",
            "weekly",
            "monthly"
          ]
        },
        "price_type": {
          "enum": [
            "raw_close",
            "adjusted_close",
            "total_return_index"
          ]
        },
        "return_convention": {
          "enum": [
            "price_return",
            "total_return"
          ]
        },
        "series": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "date",
              "prices"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "prices": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "additionalProperties": false
          }
        },
        "provenance": {
          "type": "object",
          "required": [
            "source",
            "data_version"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "data_version": {
              "type": "string",
              "minLength": 1
            },
            "retrieved_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "simulation": {
      "type": "object",
      "required": [
        "start_date",
        "end_date",
        "strategy_type",
        "execution_model"
      ],
      "properties": {
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "strategy_type": {
          "enum": [
            "buy_and_hold",
            "periodic_rebalancing",
            "threshold_rebalancing"
          ]
        },
        "rebalancing_frequency": {
          "enum": [
            "monthly",
            "quarterly",
            "semiannual",
            "annual"
          ]
        },
        "drift_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "execution_model": {
          "enum": [
            "next_available_open",
            "next_available_close"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy_type": {
                "const": "periodic_rebalancing"
              }
            },
            "required": [
              "strategy_type"
            ]
          },
          "then": {
            "required": [
              "rebalancing_frequency"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy_type": {
                "const": "threshold_rebalancing"
              }
            },
            "required": [
              "strategy_type"
            ]
          },
          "then": {
            "required": [
              "drift_threshold"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "assumptions": {
      "type": "object",
      "required": [
        "fractional_shares",
        "allow_short_selling",
        "allow_leverage",
        "commission_fixed",
        "commission_rate",
        "slippage_bps",
        "cash_return_annual",
        "risk_free_rate_annual"
      ],
      "properties": {
        "fractional_shares": {
          "type": "boolean"
        },
        "allow_short_selling": {
          "const": false
        },
        "allow_leverage": {
          "const": false
        },
        "commission_fixed": {
          "type": "number",
          "minimum": 0
        },
        "commission_rate": {
          "type": "number",
          "minimum": 0
        },
        "slippage_bps": {
          "type": "number",
          "minimum": 0
        },
        "cash_return_annual": {
          "type": "number"
        },
        "risk_free_rate_annual": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "benchmark_id",
          "observations"
        ],
        "properties": {
          "benchmark_id": {
            "type": "string",
            "minLength": 1
          },
          "observations": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "date",
                "value"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "integration": {
      "type": "object",
      "properties": {
        "generate_visualization_handoff": {
          "type": "boolean"
        },
        "include_audit_manifest": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object"
    }
  }
}
