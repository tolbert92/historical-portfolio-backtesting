{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Historical Backtest Visualization Handoff v1.0",
  "required": [
    "schema_version",
    "source_skill",
    "run_id",
    "status",
    "series"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source_skill": {
      "const": "historical-portfolio-backtesting"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed"
      ]
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "series_id",
          "points"
        ],
        "properties": {
          "series_id": {
            "type": "string",
            "minLength": 1
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "date",
                "value"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "value": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
